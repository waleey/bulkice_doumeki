# sleep.sub — final Condor submit file

executable = sleep.sh
arguments  = $(ProcId)

# Explicitly transfer everything needed
transfer_input_files = sleep.sh
should_transfer_files = YES

when_to_transfer_output = ON_EXIT
transfer_output_remaps = "output=/data/user/wkarim/output/job_$(ClusterId)_$(ProcId)"

# Logging
log    = sleep.log
output = sleep.out
error  = sleep.err

# Resources
request_cpus   = 4
request_memory = 4GB
request_disk   = 4GB

queue 